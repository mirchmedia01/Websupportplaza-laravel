APP_NAME="Web Support Plaza"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://websupportplaza.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@mail.sprintmediadesign.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
CONTACT_TO_ADDRESS="marketing@mirchmedia.com"

VITE_APP_NAME="${APP_NAME}"
